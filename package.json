{
  "name": "duall",
  "main": "expo-router/entry",
  "version": "1.0.0-alpha2",
  "homepage": "https://github.com/gccody/DUALL",
  "scripts": {
    "start": "bun x expo start",
    "start:remote": "bun x expo start --tunnel",
    "android": "bun x expo run:android",
    "build:dev:android": "EAS_SKIP_AUTO_FINGERPRINT=1 bun x eas-cli@latest build --platform android --profile development",
    "build:dev:ios": "EAS_SKIP_AUTO_FINGERPRINT=1 bun x eas-cli@latest build --platform ios --profile development",
    "build:dev": "EAS_SKIP_AUTO_FINGERPRINT=1 bun x eas-cli@latest build --profile development",
    "ios": "bun x expo run:ios",
    "test": "jest --runInBand --passWithNoTests",
    "lint": "bun x expo lint",
    "fetch:data": "bun run scripts/scrapeTotp.ts",
    "push:dev": "git checkout development && git reset --hard main && git push origin development --force"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|crypto-es)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "crypto-es": "^2.1.0",
    "expo": "~58.0.16",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "fuse.js": "^7.1.0",
    "hi-base32": "^0.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^4.6.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "cli-progress": "^3.12.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "sharp": "^0.34.3",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
